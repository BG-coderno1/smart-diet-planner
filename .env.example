# Copy this file to .env and fill in real values for your environment.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Leave unset to use a local SQLite file automatically (fine for dev/demo).
# For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://sdp_user:sdp_password@localhost:5432/smart_diet_planner
DATABASE_URL=

# Optional third-party nutrition lookup (app works fully without these)
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# auto | lite | deep
VISION_BACKEND=auto

PORT=5000
